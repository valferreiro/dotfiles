{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/images/pfp.jpeg",
    "width": 32,
    "padding": {
      "right": 5
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "cyan"
      }
    },

    "separator",

    {
      "type": "os",
      "key": "✦︎ OS"
    },

    {
      "type": "kernel",
      "key": "✦︎ Kernel"
    },

    {
      "type": "packages",
      "key": "✦︎ Packages"
    },

    {
      "type": "de",
      "key": "✦︎ Desktop"
    },

    {
      "type": "shell",
      "key": "✦︎ Shell"
    },

    {
      "type": "terminal",
      "key": "✦︎ Terminal"
    },

    {
      "type": "terminalfont",
      "key": "✦︎ Font"
    },

    {
      "type": "cpu",
      "key": "✦︎ CPU"
    },

    {
      "type": "gpu",
     "key": "✦︎ GPU"
    },

    {
      "type": "memory",
      "key": "✦︎ RAM",
      "percent": {
	"type": 9,
	"colored": true
      }
    },

    {
      "type": "disk",
      "key": "✦︎ Disk"
    },

    {
      "type": "uptime",
      "key": "✦︎ Uptime"
    },

    "break",

    "colors"
  ]
}
